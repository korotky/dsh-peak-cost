{
  "name": "dsh-peak-cost",
  "version": "0.1.0",
  "description": "Peak billing period, countdown and per-session cost estimate in the DeepSeek Harness composer statistics row",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "cost",
    "usage",
    "pricing",
    "peak-hours"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korotky/dsh-peak-cost.git"
  },
  "homepage": "https://github.com/korotky/dsh-peak-cost#readme",
  "bugs": {
    "url": "https://github.com/korotky/dsh-peak-cost/issues"
  },
  "author": "Oleg Korotkii",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@10.8.2"
}
